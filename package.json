{
  "name": "@kn0mic/agentwatch",
  "version": "0.1.2",
  "description": "One local dashboard and desktop notifications for all your AI coding agents (Claude Code, Codex, Grok).",
  "keywords": [
    "claude-code",
    "codex",
    "grok",
    "ai-agents",
    "dashboard",
    "notifications",
    "hooks",
    "vscode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/papi-knomic/agentwatch.git"
  },
  "homepage": "https://github.com/papi-knomic/agentwatch#readme",
  "bugs": {
    "url": "https://github.com/papi-knomic/agentwatch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "agentwatch": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev:web": "vite build --watch",
    "start": "node dist/cli/index.js start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
